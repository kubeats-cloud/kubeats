# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets stay local, the template is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Data backups — never commit customer data
backups/

# Cloudflare adapter output
.open-next/
.wrangler/
# Local Worker secrets for `wrangler dev` — same rule as .env.local
.dev.vars
.dev.vars.*

# Throwaway verification harnesses. They read .env.local at runtime and hold no
# secrets themselves, but they are not part of the app and one already reached a
# commit by way of `git add -A`.
_s4*
_v12*
_check.mjs
_rules.mjs
_sess.mjs
# Supabase CLI scratch. NEVER COMMIT: it holds pooler-url, which is a live
# database connection string, alongside the linked project ref and the running
# versions. Regenerated by the CLI on demand, so nothing here is worth keeping.
supabase/.temp/
