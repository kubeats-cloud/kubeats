{
  "$schema": "node_modules/wrangler/config-schema.json",

  // KUbeats on Cloudflare Workers.
  //
  // The app itself knows nothing about Cloudflare — no platform imports, no
  // runtime checks, no bindings reached from a component or an action. This
  // file and open-next.config.ts are the whole of the platform coupling, which
  // is what CLAUDE.md's portability rule asks for.
  "name": "kubeats",
  "main": ".open-next/worker.js",

  // Pin the runtime. Cloudflare only enables newer behaviour on or after this
  // date, so a deploy months from now behaves the way this one does.
  "compatibility_date": "2026-09-04",
  "compatibility_flags": [
    // Next's server needs Node built-ins — Buffer, crypto, streams. Without
    // this flag the Worker fails at import time, not at request time, so the
    // symptom is an entire deployment that will not boot.
    "nodejs_compat",
    // Keeps fetch() to the public internet rather than looping back into the
    // Worker, which is what the adapter expects.
    "global_fetch_strictly_public"
  ],

  // The static half of the build: /_next/static, the brand images, the icons.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // DO NOT ADD "upload_source_maps": true.
  //
  // It is the obvious next step from the line above — observability is on, and
  // a minified stack trace is close to useless without a map. It is also a key
  // disclosure. The OpenNext adapter inlines the whole environment into
  // .open-next/cloudflare/next-env.mjs as plaintext, esbuild copies that into
  // worker.js.map, and the map is ~25 MiB of which one string is
  // SUPABASE_SERVICE_ROLE_KEY. That key bypasses Row Level Security completely.
  //
  // Wrangler's default is false, which is the only reason the key stays on the
  // build machine today. scripts/trim-worker.mjs fails the build if this is
  // ever set to true, so this is not the only thing standing in the way — but
  // read the guard before you argue with it.

  // The adapter deliberately does not minify its own output, so that it can
  // apply string-replacement patches to it (see build.js: `options.minify =
  // false`). By the time Wrangler bundles, every patch is applied, so this is
  // the safe place to do it: 17.13 MiB raw / 3.67 MiB compressed becomes
  // 11.58 / 3.28, against a 3 MiB compressed limit on the free plan.
  "minify": true

  // NO ENVIRONMENT VARIABLES LIVE IN THIS FILE. There is no `vars` block and
  // there must never be one: this file is committed, and Workers Builds prints
  // plaintext `vars` into the build log. The three variables are set in the
  // Cloudflare dashboard, and SUPABASE_SERVICE_ROLE_KEY is set as a *Secret*
  // (encrypted, never printed, not readable back) rather than a Variable.
  // Locally they come from .env.local, and .dev.vars for `wrangler dev`; both
  // are git-ignored.
  //
  // Deliberately absent:
  //   r2_buckets + WORKER_SELF_REFERENCE — the incremental cache, which this
  //     app has no use for while every route is dynamic.
  //   images — next/image is set to `unoptimized`, so there is no resizing
  //     service to bind. Both brand assets are already sized for their slot.
}
