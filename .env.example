# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored — never commit real keys.
#
# All three come from the Supabase dashboard:
#   Project Settings → API

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / publishable key. Safe to expose to the browser: every request it
# makes is still constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / secret key. SERVER-ONLY — it bypasses Row Level Security.
# Never prefix this with NEXT_PUBLIC_, never import it into client code, and
# never paste it into the browser. Used only by server actions such as an admin
# creating a rep's login.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. A contact string for the User-Agent the photo-stamp's area lookup
# sends to OpenStreetMap, whose usage policy asks for one — an email address or
# a URL. Leave it unset and the lookup still works; setting it is a courtesy to
# a free service we depend on for a convenience.
# PLACE_LOOKUP_CONTACT=you@example.com

# Optional. When set, /api/health returns a real database check to a caller
# that sends this value as the x-health-token header. The public response
# stays a static {"ok":true} either way — it must never touch the database,
# because anyone can poll it. Leave unset and the deep check does not exist.
HEALTH_CHECK_TOKEN=
